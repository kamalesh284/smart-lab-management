# CampusLab Monitoring Ingestion API Configuration

PORT=8787
NODE_ENV=production

# Allowed dashboard origins (comma-separated if multiple)
DASHBOARD_ORIGINS=http://localhost:5500,https://campuslab.college.edu

# Cryptographically random 256-bit bearer token for each computer
# Example format: {"SYSTEM_ID":"TOKEN"}
AGENT_TOKENS_JSON={"LAB1-PC-001":"REPLACE_WITH_RANDOM_HEX_TOKEN_1","LAB1-PC-002":"REPLACE_WITH_RANDOM_HEX_TOKEN_2"}

# Path to Firebase Admin SDK service account key JSON file
# MUST be stored securely outside the web root and source control
# GOOGLE_APPLICATION_CREDENTIALS=C:\Secure\firebase-service-account.json
